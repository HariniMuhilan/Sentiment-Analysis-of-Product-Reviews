# Environment Configuration Template
# Copy to .env and adjust values for your environment.

# Application Configuration
APP_NAME="Sentiment Analysis API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Connection (SQLite by default, or PostgreSQL)
# Example PostgreSQL: postgresql://user:password@localhost:5432/sentiment_db
DATABASE_URL="sqlite:///./sentiment.db"

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:80"]'

# Ingestion Limits
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=120

# Frontend Environment (Vite)
# Place in sentiment-dashboard/.env if custom backend URL is needed:
# VITE_API_URL="http://localhost:8000/api"
